      "48": "Assets/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "RoValra - Roblox Improved",
   "permissions": [ "declarativeNetRequest", "storage", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
