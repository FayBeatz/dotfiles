      "matches": [ "*://*.roblox.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "Games/serverid.js", "Games/serverlistener.js", "Games/botDetector.js" ],
      "matches": [ "*://*.roblox.com/*/games/*", "*://*.roblox.com/games/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "Games/sniper.js" ],
      "matches": [ "*://*.roblox.com/*/games/*", "*://*.roblox.com/games/*" ]
   }, {
      "all_frames": true,
      "js": [ "Games/RegionPlayButton.js", "Games/Regions_contentSimple.js", "Games/serveruptime.js" ],
      "matches": [ "*://*.roblox.com/*/games/*", "*://*.roblox.com/games/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "Games/revertlogo.js", "Games/quickplay.js" ],
      "matches": [ "*://*.roblox.com/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "misc/ItemChecker.js", "Profile/RoValraBadges.js", "Profile/privateserver.js" ],
      "matches": [ "*://*.roblox.com/*/users/*", "*://*.roblox.com/users/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "misc/cssfixes.js" ],
      "matches": [ "*://*.roblox.com/*/users/*", "*://*.roblox.com/users/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "misc/40method.js" ],
      "matches": [ "*://*.roblox.com/*/catalog/*", "*://*.roblox.com/catalog/*" ],
      "run_at": "document_start"
   } ],
   "declarative_net_request": {
      "rule_resources": [ {
         "enabled": true,
         "id": "ruleset_1",
         "path": "Rules/rules.json"
      }, {
         "enabled": false,
         "id": "ruleset_2",
         "path": "Rules/regionRules.json"
      } ]
   },
   "description": "An extension aiming to provide features that other Roblox extensions pay wall!",
   "host_permissions": [ "https://games.roblox.com/*", "*://*.roblox.com/*", "https://gamejoin.roblox.com/v1/join-game-instance", "https://users.roblox.com/*" ],
   "icons": {
      "128": "Assets/icon-128.png",
